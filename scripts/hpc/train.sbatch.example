# Layout: train.sbatch (dispatcher) + one standalone script per experiment.
#   unet/  cdngi.sh  osm.sh
#   sr/    r0_cdngi.sh  r1a_cdngi.sh  r1b_cdngi.sh  r2a_cdngi.sh  r2b_cdngi.sh
#          (r1/r2: a = reflect-pad 8px, b = no pad)
# Only SEED and STAGE (tune | fit) are meant to vary at submit time.

# tune (default headers are gpu:2 — one independent tuner per GPU, no DDP)
sbatch scripts/hpc/train.sbatch --SCRIPT=unet/cdngi.sh STAGE=tune
sbatch scripts/hpc/train.sbatch --SCRIPT=sr/r2a_cdngi.sh STAGE=tune SEED=1

# fit on one GPU (override the gpu:2 header at submit time)
sbatch --gres=gpu:1 scripts/hpc/train.sbatch --SCRIPT=unet/cdngi.sh STAGE=fit
sbatch --gres=gpu:1 scripts/hpc/train.sbatch --SCRIPT=sr/r2a_cdngi.sh STAGE=fit SEED=1
